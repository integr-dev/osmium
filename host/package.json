{
  "name": "osmium-host",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "description": "Runs Minecraft agents for an Osmium backend.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "osmium-link": "./dist/bin/link.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "link": "npm run build && node dist/bin/link.js",
    "rig": "npm run build && node dist/bin/rig.js",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=github-actions --reporter=junit --outputFile.junit=test-results/junit.xml",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "minecraft-data": "^3.114.0",
    "minecraft-protocol": "^1.68.0",
    "mineflayer": "^4.38.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-auth": "^3.1.1",
    "socks": "^2.8.10",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
