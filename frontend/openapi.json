{"openapi":"3.1.0","info":{"title":"Osmium backend","description":"JWT authentication with role-grouped permission nodes. Routes authorize against nodes only, never against roles.","version":"0.0.1-SNAPSHOT"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Audit","description":"What operators did. Agent-side events are the activity feed, not this."},{"name":"Roles","description":"The seeded roles and the permission nodes they grant."},{"name":"Users","description":"Administrator-managed accounts. There is no self-registration."},{"name":"Agents","description":"Minecraft agents. Commands are routed to the host that runs them."},{"name":"Authentication","description":"Login, password rotation and self lookup."},{"name":"Hosts","description":"Machines that run the agents. They hold the credentials; Osmium does not."}],"paths":{"/api/users/{id}/role":{"put":{"tags":["Users"],"summary":"Replace the role of an account.","description":"Roles are nested seniority levels, so an account holds exactly one or none. An account cannot change its own role, so an administrator cannot demote themselves.","operationId":"replaceRole","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateRoleRequest"}}},"required":true},"responses":{"200":{"description":"Updated account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"400":{"description":"Unknown role name.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"403":{"description":"Missing node `user.role.write`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"404":{"description":"No such account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"409":{"description":"The account is the caller's own.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/users":{"get":{"tags":["Users"],"summary":"List every account.","operationId":"list","responses":{"200":{"description":"All accounts.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserResponse"}}}}},"403":{"description":"Missing node `user.read`.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"post":{"tags":["Users"],"summary":"Create an account with a chosen username and password.","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateUserRequest"}}},"required":true},"responses":{"201":{"description":"Account created.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"400":{"description":"Blank username, short password or unknown role.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"403":{"description":"Missing node `user.create`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"409":{"description":"Username already taken.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/hosts":{"get":{"tags":["Hosts"],"summary":"List hosts.","operationId":"list_1","responses":{"200":{"description":"All hosts.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/HostResponse"}}}}},"403":{"description":"Missing node `fleet.read`.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/HostResponse"}}}}}}},"post":{"tags":["Hosts"],"summary":"Enrol a host.","description":"Returns the enrolment token once. Only its hash is stored, so it cannot be retrieved later - a lost token is replaced by re-enrolling. No address is taken: the host connects to Osmium, so its location is observed on connect.","operationId":"enrol","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateHostRequest"}}},"required":true},"responses":{"201":{"description":"Host enrolled; token returned once.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostEnrolledResponse"}}}},"400":{"description":"Blank or over-long name.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostEnrolledResponse"}}}},"403":{"description":"Missing node `fleet.login`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostEnrolledResponse"}}}},"409":{"description":"Name already enrolled.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostEnrolledResponse"}}}}}}},"/api/hosts/{id}/rotate-token":{"post":{"tags":["Hosts"],"summary":"Issue a new enrolment token.","description":"Invalidates the previous token and closes the host's current connection, so it must reconnect with the new one. Use this instead of deleting a host when a token leaks - the host keeps its agents.","operationId":"rotateToken","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"New token, returned once.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostEnrolledResponse"}}}},"403":{"description":"Missing node `fleet.login`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostEnrolledResponse"}}}},"404":{"description":"No such host.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostEnrolledResponse"}}}}}}},"/api/auth/password":{"post":{"tags":["Authentication"],"summary":"Rotate the password of the authenticated account.","description":"Requires the current password. Any authenticated account may call this for itself.","operationId":"changePassword","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PasswordChangeRequest"}}},"required":true},"responses":{"204":{"description":"Password changed."},"400":{"description":"New password rejected."},"401":{"description":"Missing token or wrong current password."}}}},"/api/auth/login":{"post":{"tags":["Authentication"],"summary":"Exchange credentials for an access token.","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"Token issued.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"401":{"description":"Unknown username or wrong password.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}}},"security":[]}},"/api/agents":{"get":{"tags":["Agents"],"summary":"List every agent.","operationId":"list_2","responses":{"200":{"description":"All agents.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AgentResponse"}}}}},"403":{"description":"Missing node `fleet.read`.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AgentResponse"}}}}}}},"post":{"tags":["Agents"],"summary":"Create an agent slot.","description":"Nothing has touched Minecraft at this point; the agent starts UNLINKED.","operationId":"create_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateAgentRequest"}}},"required":true},"responses":{"201":{"description":"Agent created.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"400":{"description":"Invalid fields, or unknown host.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"403":{"description":"Missing node `fleet.control`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"409":{"description":"Label already in use.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}}}}},"/api/agents/{id}/setup":{"post":{"tags":["Agents"],"summary":"Ask the host to set this agent up.","description":"Sends `setup_agent` and moves the agent to SETUP_PENDING. Osmium does not perform or observe the login - the host reports back a verdict.","operationId":"setup","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetupAgentRequest"}}},"required":true},"responses":{"200":{"description":"Command accepted; agent is SETUP_PENDING.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"403":{"description":"Missing node `fleet.login`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"404":{"description":"No such agent.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"409":{"description":"Setup already running, or the agent is online.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"503":{"description":"The owning host is not connected.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}}}}},"/api/agents/{id}/disconnect":{"post":{"tags":["Agents"],"summary":"Disconnect the agent from its Minecraft server.","operationId":"disconnect","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Command accepted.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"403":{"description":"Missing node `fleet.control`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"404":{"description":"No such agent.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"409":{"description":"The agent is not online.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"503":{"description":"The owning host is not connected.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}}}}},"/api/agents/{id}/connect":{"post":{"tags":["Agents"],"summary":"Connect the agent to its Minecraft server.","operationId":"connect","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Command accepted.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"403":{"description":"Missing node `fleet.control`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"404":{"description":"No such agent.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"409":{"description":"The agent has not been set up.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"503":{"description":"The owning host is not connected.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}}}}},"/api/agents/{id}/chat":{"post":{"tags":["Agents"],"summary":"Speak in game as this agent.","description":"Impersonation: this says something under an account you own, so it is gated separately from fleet.control.","operationId":"chat","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChatRequest"}}},"required":true},"responses":{"200":{"description":"Command accepted.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"400":{"description":"Blank or over-long message.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"403":{"description":"Missing node `fleet.chat`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"404":{"description":"No such agent.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"409":{"description":"The agent is not online.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"503":{"description":"The owning host is not connected.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}}}}},"/api/users/{id}":{"delete":{"tags":["Users"],"summary":"Delete an account.","description":"An account cannot delete itself, so an administrator cannot lock themselves out.","operationId":"delete","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"Account deleted."},"403":{"description":"Missing node `user.delete`."},"404":{"description":"No such account."},"409":{"description":"The account is the caller's own."}}},"patch":{"tags":["Users"],"summary":"Edit another account.","description":"Supplying a password resets it without knowing the current one. An account cannot target itself here - use PATCH /api/users/me and POST /api/auth/password - so changing your own password always requires the current one.","operationId":"update","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateUserRequest"}}},"required":true},"responses":{"200":{"description":"Updated account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"400":{"description":"Blank username or password outside the allowed length.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"403":{"description":"Missing node `user.edit`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"404":{"description":"No such account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"409":{"description":"Username already taken, or the account is the caller's own.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/users/me":{"patch":{"tags":["Users"],"summary":"Edit the authenticated account.","description":"Renaming yourself invalidates tokens issued under the old username, since the token subject no longer resolves. Log in again afterwards.","operationId":"updateSelf","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateSelfRequest"}}},"required":true},"responses":{"200":{"description":"Updated account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"400":{"description":"Blank or over-long username.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"403":{"description":"Missing node `user.edit.self`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"409":{"description":"Username already taken.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/hosts/{id}":{"delete":{"tags":["Hosts"],"summary":"Remove a host.","description":"Cascades to its agents, which cannot run without it. Invalidates the token.","operationId":"delete_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"Host and its agents removed."},"403":{"description":"Missing node `fleet.login`."},"404":{"description":"No such host."}}},"patch":{"tags":["Hosts"],"summary":"Rename a host.","description":"Only the name is editable; address, version and reachability are observed from the connection rather than configured.","operationId":"rename","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateHostRequest"}}},"required":true},"responses":{"200":{"description":"Updated host.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostResponse"}}}},"400":{"description":"Blank or over-long name.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostResponse"}}}},"403":{"description":"Missing node `fleet.login`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostResponse"}}}},"404":{"description":"No such host.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostResponse"}}}},"409":{"description":"Name already enrolled.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HostResponse"}}}}}}},"/api/agents/{id}":{"get":{"tags":["Agents"],"summary":"Read one agent.","operationId":"get","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"The agent.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"403":{"description":"Missing node `fleet.read`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"404":{"description":"No such agent.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}}}},"delete":{"tags":["Agents"],"summary":"Delete an agent.","operationId":"delete_2","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"Agent deleted."},"403":{"description":"Missing node `fleet.control`."},"404":{"description":"No such agent."}}},"patch":{"tags":["Agents"],"summary":"Rename an agent or move it to another server.","description":"Omitted fields are left alone. Moving does not affect credentials - the account is the same wherever it joins - but the agent must be offline first.","operationId":"update_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateAgentRequest"}}},"required":true},"responses":{"200":{"description":"Updated agent.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"400":{"description":"Blank or over-long field.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"403":{"description":"Missing node `fleet.control`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"404":{"description":"No such agent.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}},"409":{"description":"Label taken, or the agent is online.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgentResponse"}}}}}}},"/api/roles":{"get":{"tags":["Roles"],"summary":"List every role with its permission nodes.","operationId":"list_3","responses":{"200":{"description":"All roles.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/RoleResponse"}}}}},"403":{"description":"Missing node `role.read`.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/RoleResponse"}}}}}}}},"/api/auth/me":{"get":{"tags":["Authentication"],"summary":"Return the authenticated account.","operationId":"me","responses":{"200":{"description":"The current account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"401":{"description":"Missing or invalid token.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"403":{"description":"Missing node `user.read.self`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/audit":{"get":{"tags":["Audit"],"summary":"List recent operator actions, newest first.","description":"Entries are kept for 30 days by default and purged daily.","operationId":"list_4","parameters":[{"name":"limit","in":"query","description":"How many entries to return, newest first. Clamped to 1..1000.","required":false,"schema":{"type":"integer","format":"int32","default":200}}],"responses":{"200":{"description":"Recent entries.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AuditEntryResponse"}}}}},"403":{"description":"Missing node `audit.read`.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AuditEntryResponse"}}}}}}}}},"components":{"schemas":{"UpdateRoleRequest":{"type":"object","description":"Replaces the role of an account. Null clears it, leaving no permissions.","properties":{"role":{"type":["string","null"]}}},"UserResponse":{"type":"object","description":"A user account. Passwords are never returned.","properties":{"id":{"type":"integer","format":"int64"},"username":{"type":"string"},"role":{"type":["string","null"],"description":"Assigned role, or null when the account has none.","example":"administrator"},"nodes":{"type":"array","description":"Permission nodes granted by the assigned role.","items":{"type":"string"}}}},"CreateUserRequest":{"type":"object","description":"Creates an account with an administrator-chosen username and password.","properties":{"username":{"type":"string","maxLength":64,"minLength":0},"password":{"type":"string","maxLength":72,"minLength":4},"role":{"type":["string","null"],"description":"Role name to assign. Must already exist. Omit for no permissions."}},"required":["username"]},"CreateHostRequest":{"type":"object","description":"Enrols a host. No address: the host dials in, so its location is observed.","properties":{"name":{"type":"string","maxLength":64,"minLength":0}},"required":["name"]},"HostEnrolledResponse":{"type":"object","description":"A freshly enrolled host, with its enrolment token shown exactly once.","properties":{"host":{"$ref":"#/components/schemas/HostResponse"},"token":{"type":"string","description":"Give this to the host. It is hashed on the server and never shown again."}}},"HostResponse":{"type":"object","description":"A host. Reachability is derived from the heartbeat, not stored.","properties":{"id":{"type":"integer","format":"int64"},"name":{"type":"string"},"address":{"type":["string","null"],"description":"Observed when the host connects. Null until it first dials in."},"hostVersion":{"type":["string","null"]},"lastSeenAt":{"type":["string","null"],"format":"date-time"},"reachable":{"type":"boolean"},"agentCount":{"type":"integer","format":"int64"}}},"PasswordChangeRequest":{"type":"object","description":"Rotates the password of the authenticated account.","properties":{"currentPassword":{"type":"string","minLength":1},"newPassword":{"type":"string","maxLength":72,"minLength":4}},"required":["currentPassword"]},"LoginRequest":{"type":"object","description":"Credentials for a login attempt.","properties":{"username":{"type":"string","example":"admin","minLength":1},"password":{"type":"string","example":"admin","minLength":1}},"required":["password","username"]},"LoginResponse":{"type":"object","description":"A freshly issued access token.","properties":{"token":{"type":"string","description":"Signed JWT to send as `Authorization: Bearer <token>`."},"expiresAt":{"type":"string","format":"date-time"}}},"CreateAgentRequest":{"type":"object","description":"Creates an agent slot. Nothing has touched Minecraft at this point.","properties":{"label":{"type":"string","maxLength":64,"minLength":0},"hostId":{"type":"integer","format":"int64"},"serverAddress":{"type":"string","example":"mc.example.com:25565","maxLength":128,"minLength":0}},"required":["label","serverAddress"]},"AgentResponse":{"type":"object","description":"An agent. Only its Minecraft identity is stored, never a credential.","properties":{"id":{"type":"integer","format":"int64"},"label":{"type":"string"},"hostId":{"type":"integer","format":"int64"},"hostName":{"type":"string"},"serverAddress":{"type":"string"},"state":{"type":"string","description":"Stored state, adjusted to STALE when the owning host is unreachable.","enum":["UNLINKED","SETUP_PENDING","LINKED","ONLINE","NEEDS_RELINK","CONNECT_FAILED","STALE"]},"mcUsername":{"type":["string","null"]},"mcUuid":{"type":["string","null"]}}},"SetupAgentRequest":{"type":"object","description":"Asks the host to set the agent up. The method is a mechanism the operator chose, relayed to the host uninterpreted. It must never identify an account.","properties":{"method":{"type":"string","example":"device_code","maxLength":32,"minLength":0}},"required":["method"]},"ChatRequest":{"type":"object","description":"Sends a chat message as an agent. This is impersonation - gated on fleet.chat.","properties":{"message":{"type":"string","maxLength":256,"minLength":0}},"required":["message"]},"UpdateUserRequest":{"type":"object","description":"Edits any account. Only an administrator can set a password without knowing the old one.","properties":{"username":{"type":"string","maxLength":64,"minLength":0},"password":{"type":["string","null"],"description":"Omit to leave the password untouched.","maxLength":72,"minLength":4}},"required":["username"]},"UpdateSelfRequest":{"type":"object","description":"Edits the authenticated account. The role is deliberately not editable here.","properties":{"username":{"type":"string","maxLength":64,"minLength":0}},"required":["username"]},"UpdateHostRequest":{"type":"object","description":"Renames a host. Everything else about a host is observed, not configured.","properties":{"name":{"type":"string","maxLength":64,"minLength":0}},"required":["name"]},"UpdateAgentRequest":{"type":"object","description":"Edits an agent. Omitted fields are left alone. Moving an agent to another Minecraft server does not affect its credentials - the account is the account, whichever server it joins - but it must not be connected at the time.","properties":{"label":{"type":["string","null"],"maxLength":64,"minLength":0},"serverAddress":{"type":["string","null"],"description":"Move the agent to this server. Only while it is not online.","maxLength":128,"minLength":0}}},"RoleResponse":{"type":"object","description":"A role and the permission nodes it grants.","properties":{"id":{"type":"integer","format":"int64"},"name":{"type":"string"},"nodes":{"type":"array","items":{"type":"string"}}}},"AuditEntryResponse":{"type":"object","description":"One operator action: who did what, to which agent or host.","properties":{"id":{"type":"integer","format":"int64"},"at":{"type":"string","format":"date-time"},"account":{"type":"string"},"action":{"type":"string","enum":["AGENT_CREATE","AGENT_UPDATE","AGENT_DELETE","AGENT_SETUP","AGENT_CONNECT","AGENT_DISCONNECT","AGENT_CHAT","HOST_ENROL","HOST_RENAME","HOST_ROTATE_TOKEN","HOST_DELETE","USER_CREATE","USER_UPDATE","USER_DELETE","USER_ROLE_CHANGE","USER_PASSWORD_CHANGE"]},"target":{"type":"string"},"detail":{"type":["string","null"]}}}},"securitySchemes":{"bearerAuth":{"type":"http","in":"header","scheme":"bearer","bearerFormat":"JWT"}}}}