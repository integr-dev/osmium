{"openapi":"3.1.0","info":{"title":"Osmium backend","description":"JWT authentication with role-grouped permission nodes. Routes authorize against nodes only, never against roles.","version":"0.0.1-SNAPSHOT"},"servers":[{"url":"http://localhost:8099","description":"Generated server url"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Roles","description":"The seeded roles and the permission nodes they grant."},{"name":"Users","description":"Administrator-managed accounts. There is no self-registration."},{"name":"Authentication","description":"Login, password rotation and self lookup."}],"paths":{"/api/users/{id}/role":{"put":{"tags":["Users"],"summary":"Replace the role of an account.","description":"Roles are nested seniority levels, so an account holds exactly one or none.","operationId":"replaceRole","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateRoleRequest"}}},"required":true},"responses":{"200":{"description":"Updated account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"400":{"description":"Unknown role name.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"403":{"description":"Missing node `user.roles.write`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"404":{"description":"No such account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/users":{"get":{"tags":["Users"],"summary":"List every account.","operationId":"list","responses":{"200":{"description":"All accounts.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserResponse"}}}}},"403":{"description":"Missing node `user.read`.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"post":{"tags":["Users"],"summary":"Create an account with a chosen username and password.","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateUserRequest"}}},"required":true},"responses":{"201":{"description":"Account created.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"400":{"description":"Blank username, short password or unknown role.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"403":{"description":"Missing node `user.create`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"409":{"description":"Username already taken.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/auth/password":{"post":{"tags":["Authentication"],"summary":"Rotate the password of the authenticated account.","description":"Requires the current password. Any authenticated account may call this for itself.","operationId":"changePassword","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PasswordChangeRequest"}}},"required":true},"responses":{"204":{"description":"Password changed."},"400":{"description":"New password rejected."},"401":{"description":"Missing token or wrong current password."}}}},"/api/auth/login":{"post":{"tags":["Authentication"],"summary":"Exchange credentials for an access token.","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"Token issued.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"401":{"description":"Unknown username or wrong password.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}}},"security":[]}},"/api/users/{id}":{"delete":{"tags":["Users"],"summary":"Delete an account.","description":"An account cannot delete itself, so an administrator cannot lock themselves out.","operationId":"delete","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"Account deleted."},"403":{"description":"Missing node `user.delete`."},"404":{"description":"No such account."},"409":{"description":"The account is the caller's own."}}},"patch":{"tags":["Users"],"summary":"Edit any account.","description":"Supplying a password resets it without knowing the current one.","operationId":"update","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateUserRequest"}}},"required":true},"responses":{"200":{"description":"Updated account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"400":{"description":"Blank username or password outside the allowed length.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"403":{"description":"Missing node `user.edit`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"404":{"description":"No such account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"409":{"description":"Username already taken.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/users/me":{"patch":{"tags":["Users"],"summary":"Edit the authenticated account.","description":"Renaming yourself invalidates tokens issued under the old username, since the token subject no longer resolves. Log in again afterwards.","operationId":"updateSelf","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateSelfRequest"}}},"required":true},"responses":{"200":{"description":"Updated account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"400":{"description":"Blank or over-long username.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"403":{"description":"Missing node `user.edit.self`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"409":{"description":"Username already taken.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/roles":{"get":{"tags":["Roles"],"summary":"List every role with its permission nodes.","operationId":"list_1","responses":{"200":{"description":"All roles.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/RoleResponse"}}}}},"403":{"description":"Missing node `role.read`.","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/RoleResponse"}}}}}}}},"/api/auth/me":{"get":{"tags":["Authentication"],"summary":"Return the authenticated account.","operationId":"me","responses":{"200":{"description":"The current account.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"401":{"description":"Missing or invalid token.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"403":{"description":"Missing node `user.read.self`.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}}},"components":{"schemas":{"UpdateRoleRequest":{"type":"object","description":"Replaces the role of an account. Null clears it, leaving no permissions.","properties":{"role":{"type":["string","null"]}}},"UserResponse":{"type":"object","description":"A user account. Passwords are never returned.","properties":{"id":{"type":"integer","format":"int64"},"username":{"type":"string"},"role":{"type":["string","null"],"description":"Assigned role, or null when the account has none.","example":"administrator"},"nodes":{"type":"array","description":"Permission nodes granted by the assigned role.","items":{"type":"string"}}}},"CreateUserRequest":{"type":"object","description":"Creates an account with an administrator-chosen username and password.","properties":{"username":{"type":"string","maxLength":64,"minLength":0},"password":{"type":"string","maxLength":72,"minLength":4},"role":{"type":["string","null"],"description":"Role name to assign. Must already exist. Omit for no permissions."}},"required":["username"]},"PasswordChangeRequest":{"type":"object","description":"Rotates the password of the authenticated account.","properties":{"currentPassword":{"type":"string","minLength":1},"newPassword":{"type":"string","maxLength":72,"minLength":4}},"required":["currentPassword"]},"LoginRequest":{"type":"object","description":"Credentials for a login attempt.","properties":{"username":{"type":"string","example":"admin","minLength":1},"password":{"type":"string","example":"admin","minLength":1}},"required":["password","username"]},"LoginResponse":{"type":"object","description":"A freshly issued access token.","properties":{"token":{"type":"string","description":"Signed JWT to send as `Authorization: Bearer <token>`."},"expiresAt":{"type":"string","format":"date-time"}}},"UpdateUserRequest":{"type":"object","description":"Edits any account. Only an administrator can set a password without knowing the old one.","properties":{"username":{"type":"string","maxLength":64,"minLength":0},"password":{"type":["string","null"],"description":"Omit to leave the password untouched.","maxLength":72,"minLength":4}},"required":["username"]},"UpdateSelfRequest":{"type":"object","description":"Edits the authenticated account. The role is deliberately not editable here.","properties":{"username":{"type":"string","maxLength":64,"minLength":0}},"required":["username"]},"RoleResponse":{"type":"object","description":"A role and the permission nodes it grants.","properties":{"id":{"type":"integer","format":"int64"},"name":{"type":"string"},"nodes":{"type":"array","items":{"type":"string"}}}}},"securitySchemes":{"bearerAuth":{"type":"http","in":"header","scheme":"bearer","bearerFormat":"JWT"}}}}