server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # --- Security headers, applied to every response (`always` = on errors too) ---
    #
    # CSP is strict on scripts: the Vite production build emits external, content-hashed JS, so no
    # inline script is needed and `script-src 'self'` blocks any injected <script> or inline handler.
    # That is the layer that actually contains an XSS. No credential is readable by script - the
    # access token is in memory, the refresh token is an HttpOnly cookie - but a script on the page
    # could still act as the operator, and this is what stops one running at all.
    #
    # style-src keeps 'unsafe-inline' because Vue :style bindings and Tailwind emit inline styles;
    # inline styles are a far weaker vector than inline scripts, which stay locked to 'self'.
    #
    # connect-src 'self' is enough while the API is proxied same-origin below. Widen it only if the
    # frontend ever calls a different host directly.
    #
    # img-src carries blob: for player heads. /api/avatars is gated on fleet.read and an <img> cannot
    # send a bearer token, so the SPA fetches each head and hands the element an object URL. blob: is
    # same-origin by construction - it can only name a blob this document already created - so this
    # is not the third-party image host the proxy exists to avoid.
    #
    # These are set at the server level and inherited by the locations below, which deliberately use
    # `expires` (not `add_header`) for caching, since an `add_header` in a location would drop this
    # inherited set.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

    # Content-hashed filenames, so they can be cached indefinitely.
    location /assets/ {
        expires 1y;
    }

    # Keeps the SPA same-origin with the API, so no CORS configuration is needed.
    # Only ${BACKEND_URL} and ${DNS_RESOLVER} are substituted at start-up; nginx's own $variables
    # have no braces. proxy_set_header sets request headers, so it leaves the inherited response
    # headers alone.
    #
    # The upstream is passed through a variable on purpose: with a literal proxy_pass, nginx resolves
    # the host at boot and refuses to start if the backend isn't up yet - a crash loop when the
    # frontend container starts first. Routing through $backend defers resolution to request time via
    # the resolver below, so nginx boots regardless and returns a per-request 502 until the backend
    # appears. DNS_RESOLVER is environment-specific: 127.0.0.11 for Docker/Compose, the cluster DNS
    # for Kubernetes.
    # Server-sent events. Matched before /api/ because nginx prefers the longer prefix, and it needs
    # the opposite settings to an ordinary request:
    #
    #   proxy_buffering off  - buffering holds events until the buffer fills, which for a channel
    #                          that is idle most of the time means they arrive in unpredictable
    #                          batches, or not at all.
    #   proxy_read_timeout   - the default 60s severs a stream that has simply had nothing to say.
    #                          The backend sends a keep-alive comment every 30s, so this only has to
    #                          outlast that with room to spare.
    #
    # Deliberately no `add_header` here: inside a location it *replaces* the inherited set, which
    # would silently drop the security headers above for this path. See the note at the top.
    location /api/stream/ {
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        # ipv6=off: resolve to A records only. Without it the resolver may hand back an AAAA record
        # for a backend that only listens on IPv4, which fails as a 502. Matches how the old literal
        # proxy_pass behaved. Drop it only in an IPv6-native deployment.
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # vue-router uses createWebHistory, so unknown paths fall through to the entry point.
    # `expires epoch` sets Cache-Control: no-cache without an add_header, so index.html is never
    # stale after a deploy while the security headers above still apply.
    location / {
        try_files $uri $uri/ /index.html;
        expires epoch;
    }
}
