{
  "name": "osmium-fe",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/viewer-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/viewer-assets.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "api:generate": "npx --yes openapi-typescript@7 openapi.json -o src/api/schema.d.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=github-actions --reporter=junit --outputFile.junit=test-results/junit.xml"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.2",
    "prismarine-viewer": "^1.33.0",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "assert": "^2.1.0",
    "daisyui": "^5.7.16",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "minecraft-assets": "^1.19.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "util": "^0.12.5",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
