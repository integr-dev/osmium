# Repository-wide ignores. Module-specific rules live in backend/.gitignore and
# frontend/.gitignore; this file only covers things that can appear anywhere.

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
*.iml
*.swp
*.swo

# Environment and secrets
.env
.env.*
!.env.example

# Build output and dependencies, as a safety net for new modules
node_modules/
dist/
build/
*.log

# The one directory called `build` that is source rather than output: the host's printer. The rule
# above is a safety net for a module nobody has written a .gitignore for yet, and it quietly
# swallowed a directory named after what the code in it does.
!host/src/agent/build/

frontend/meow.sh
